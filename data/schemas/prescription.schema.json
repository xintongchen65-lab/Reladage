{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"RehabMotion Prescription",
  "type":"object",
  "required":["plan_id","patient_id","items"],
  "properties":{
    "plan_id":{"type":"integer"},
    "patient_id":{"type":"string"},
    "issued_by":{"type":"string"},
    "items":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"object","required":["exercise_id","name","sets","reps","target_deg"],"properties":{
      "exercise_id":{"type":"integer","minimum":0,"maximum":7},
      "name":{"type":"string"},"sets":{"type":"integer","minimum":1},"reps":{"type":"integer","minimum":1},
      "target_deg":{"type":"number"},"hold_sec":{"type":"number","minimum":0},"rest_sec":{"type":"integer","minimum":0}
    }}}
  }
}
