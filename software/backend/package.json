{
  "name": "rehabmotion-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:env": "node --env-file-if-exists=.env.local scripts/check-env.mjs",
    "check:deployment": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "fastify": "5.12.1",
    "jose": "6.2.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
